# Normalize every text file to LF on checkout for all platforms: newline-sensitive tooling
# (skill frontmatter, layout whitelists, shell steps) parses line endings byte-exactly, and
# the exported template must build identically from a Windows clone.
* text=auto eol=lf

# Preserve published migration/checksum bytes across checkout platforms.
migrations/sqlite/0013_prefix_*.sql -text
migrations/postgres/0013_prefix_*.sql -text
migrations/mysql/0013_prefix_*.sql -text
migrations/core/**/*.sql -text
migrations/platform/**/*.sql -text
migrations/modules/**/*.sql -text
migrations/metadata.gen.json -text
migrations/catalogdata/catalog.gen.go -text

# Linux archive entry points must remain executable shell scripts on every checkout OS.
deploy/tar/unicore text eol=lf
deploy/tar/unicorehelp text eol=lf
