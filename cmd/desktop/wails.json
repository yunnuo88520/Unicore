{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "Unicore",
  "outputfilename": "unicore-desktop",
  "frontend:dir": "../..",
  "frontend:install": "pnpm install --frozen-lockfile",
  "frontend:build": "pnpm --filter @unicore/desktop build",
  "frontend:dev:watcher": "pnpm --filter @unicore/desktop dev",
  "frontend:dev:serverUrl": "http://localhost:5174",
  "wailsjsdir": "../../apps/desktop",
  "build:dir": "../../build/desktop",
  "author": {
    "name": "yunnuo",
    "email": "ymz@ebox.vip"
  },
  "info": {
    "companyName": "yunnuo",
    "productName": "Unicore",
    "productVersion": "0.1.1",
    "copyright": "© yunnuo · ymz@ebox.vip",
    "comments": "Unicore · Go + React"
  },
  "preBuildHooks": {
    "*/*": "pnpm --dir ../../.. design:generate"
  }
}
