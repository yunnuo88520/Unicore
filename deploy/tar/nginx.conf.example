# Author: yunnuo <ymz@ebox.vip>
# Change listen/server_name and configure TLS at the public edge (including Baota).
# Only fingerprinted assets bypass Go; Go owns installation, custom admin paths and branding.
server {
    listen 127.0.0.1:8088;
    server_name localhost;
    root /opt/unicore/current/web;
    index index.html;
    client_max_body_size 2m;
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    # Bound each multipart request; total file limit remains an administrator policy.
    location ~ ^/api/v1/(admin/)?files/multipart/[^/]+/parts/[0-9]+$ {
        client_max_body_size 64m;
        proxy_request_buffering off;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
    location ~ ^/api/v1/(admin/)?files/multipart/[^/]+/complete$ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 7200s;
    }
    # Compatibility for older clients using the single-request upload API.
    location ~ ^/api/v1/(admin/)?files/uploads/[^/]+/content$ {
        client_max_body_size 1024m;
        proxy_request_buffering off;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
