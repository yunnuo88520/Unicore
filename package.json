{
  "name": "unicore",
  "version": "0.1.2",
  "private": true,
  "author": "yunnuo <ymz@ebox.vip>",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --filter @unicore/web dev",
    "build": "pnpm --filter @unicore/web build && pnpm --filter @unicore/desktop build",
    "version:sync": "node scripts/version.mjs",
    "check:version": "node scripts/version.mjs --check",
    "generate": "node scripts/version.mjs && node scripts/generate-contracts.mjs",
    "check:contracts": "node scripts/generate-contracts.mjs --check",
    "generate:migrations": "node scripts/generate-migrations.mjs",
    "check:migrations": "node scripts/generate-migrations.mjs --check",
    "test:migrations": "node --test scripts/generate-migrations.test.mjs",
    "check:boundaries": "go run ./scripts/check-boundaries",
    "check:authors": "node scripts/check-authors.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "go build -o build/bin/oidcprovider ./tests/oidcprovider && go build -o build/bin/storagefixture ./tests/storagefixture && playwright test",
    "test:features": "node scripts/test-features.mjs",
    "design:generate": "node scripts/version.mjs && node scripts/product-identity.mjs && node scripts/generate-theme.mjs && node scripts/generate-brand.mjs && node scripts/sync-brand.mjs && node scripts/generate-contracts.mjs",
    "check:design": "node scripts/product-identity.mjs --check && node scripts/generate-theme.mjs --check && node scripts/generate-brand.mjs --check && node scripts/check-design.mjs",
    "product:generate": "node scripts/product-identity.mjs",
    "product:check": "node scripts/product-identity.mjs --check",
    "check:native": "node scripts/check-native-brand.mjs",
    "test:theme": "node scripts/verify-theme.mjs",
    "ai:context": "node scripts/ai-context.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "create:project": "node scripts/create-project.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:tooling": "node --test scripts/create-project.test.mjs scripts/wiki.test.mjs scripts/distribution.test.mjs scripts/release-assets.test.mjs scripts/update-sign.test.mjs scripts/check-i18n.test.mjs scripts/release-notes.test.mjs scripts/product-identity.test.mjs",
    "wiki:generate": "node scripts/wiki.mjs",
    "check:wiki": "node scripts/wiki.mjs --check",
    "wiki:publish": "node scripts/wiki.mjs --publish",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:release-notes": "node scripts/release-notes.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
