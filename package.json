{
  "name": "unicore",
  "version": "0.1.0",
  "private": true,
  "author": "yunnuo <ymz@ebox.vip>",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --filter @unicore/web dev",
    "build": "pnpm --filter @unicore/web build && pnpm --filter @unicore/desktop build",
    "generate": "node scripts/generate-contracts.mjs",
    "check:contracts": "node scripts/generate-contracts.mjs --check",
    "check:boundaries": "go run ./scripts/check-boundaries",
    "check:authors": "node scripts/check-authors.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "go build -o build/bin/oidcprovider ./tests/oidcprovider && playwright test",
    "design:generate": "node scripts/generate-theme.mjs && node scripts/generate-brand.mjs && node scripts/sync-brand.mjs && node scripts/generate-contracts.mjs",
    "check:design": "node scripts/generate-theme.mjs --check && node scripts/generate-brand.mjs --check && node scripts/check-design.mjs",
    "check:native": "node scripts/check-native-brand.mjs",
    "test:theme": "node scripts/verify-theme.mjs",
    "ai:context": "node scripts/ai-context.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
